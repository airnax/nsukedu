{
  "name": "nsuk-website",
  "version": "1.0.0",
  "description": "Nasarawa State University, Keffi - marketing site (Node.js + Express + Tailwind CSS)",
  "main": "server.js",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/styles.css --watch",
    "start": "node server.js",
    "dev": "npm-run-all --parallel watch:css dev:server",
    "dev:server": "node --watch server.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.17"
  }
}
